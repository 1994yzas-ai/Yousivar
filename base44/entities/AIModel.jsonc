{
  "name": "AIModel",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Engine model identifier"
    },
    "label": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "context_window": {
      "type": "number"
    },
    "supports_vision": {
      "type": "boolean",
      "default": false
    },
    "supports_web_search": {
      "type": "boolean",
      "default": false
    },
    "supports_documents": {
      "type": "boolean",
      "default": false
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "key",
    "label"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}